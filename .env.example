# Copy this file to .env and fill in the values.

# MongoDB connection string (MongoDB Atlas free tier works well):
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/topcapital
MONGODB_URI=mongodb://127.0.0.1:27017/topcapital

# Long random string used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First admin account — created automatically on first start if no admin exists.
# After the first login change the password in the admin panel ("Нууц үг солих").
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Email notification for new website messages (optional).
# Gmail: turn on 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords  and paste the 16 letters below.
SMTP_USER=
SMTP_PASS=
# Where notifications go (defaults to SMTP_USER):
NOTIFY_EMAIL=

PORT=3000
NODE_ENV=production
